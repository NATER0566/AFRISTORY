# Fastify Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/afrostory?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long_change_in_production

# Cloudinary (CDN for video streaming & image storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_cloudinary_api_key:your_cloudinary_api_secret@your_cloudinary_cloud_name

# Paystack (Fiat-to-Coin Payment Gateway)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# OneSignal (Push Notifications)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Google AdSense / Unity Ads (Ad SDK Keys)
GOOGLE_ADSENSE_CLIENT_ID=your_google_adsense_client_id
UNITY_GAME_ID=your_unity_game_id
